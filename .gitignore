# Dependencies
node_modules/
frontend/node_modules/

# Builds
frontend/.next/
frontend/out/
backend/bin/

# Environment
.env
.env.local
.env.*.local
.env.production
backend/.env

# Storage (uploaded files)
# Path asli ada di backend/storage, jadi ditulis eksplisit supaya berkas
# pendaftar (CV, surat izin, portofolio, poster) dan gambar landing tidak
# pernah ikut ter-commit.
storage/cvs/*
!storage/cvs/.gitkeep
backend/storage/*
!backend/storage/**/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log


.omp